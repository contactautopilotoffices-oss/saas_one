    "test:notifications:browser": "npm exec --yes --package=esbuild -- node --test tests/notifications/settings-browser.test.mjs",
    "test:accounts": "node --test --test-isolation=none tests/accounts-onboarding.test.mjs tests/accounts-onboarding-ui.test.mjs",
